package views

import (
	"georges/internal/store"
	"georges/internal/taxonomy"
)

// Shop is the browse page: room header, tiles, sidebar facets and the card grid.
templ Shop(p Page, f store.Filter, r *store.Result, tiles []taxonomy.Tile, tileCards map[string]store.Card, brand *store.Brand) {
	@Layout(p) {
		@ShopBody(f, r, tiles, tileCards, brand)
	}
}

templ ShopBody(f store.Filter, r *store.Result, tiles []taxonomy.Tile, tileCards map[string]store.Card, brand *store.Brand) {
	{{ u := ShopURL{Filter: f} }}
	<div id="shop">
		if brand != nil {
			<section class="brand-head">
				if brand.LogoPath != nil {
					<img src={ FileURL(*brand.LogoPath) } alt={ brand.Name } class="brand-logo"/>
				} else {
					<h1>{ brand.Name }</h1>
				}
				<div class="muted">{ Thousands(brand.Families) } products
					if brand.Website != nil {
						· <a href={ templ.SafeURL("https://" + *brand.Website) } rel="noopener" target="_blank" hx-boost="false">{ *brand.Website }</a>
					}
					· <a href={ "/catalogs?brand=" + brand.Slug }>Catalogs</a>
				</div>
			</section>
		} else if f.Category == "" && f.Query == "" && f.Brand == "" && len(tiles) > 0 {
			<section class="tiles">
				for _, t := range tiles {
					<a class="tile" href={ u.Category(t.Name) }>
						<div class="tile-img" { Placeholder(tileLQIP(tileCards, t.Name))... }>
							if c, ok := tileCards[t.Name]; ok && c.Hash != nil {
								<img { CardImg(*c.Hash, deref(c.W), deref(c.H))... } alt=""/>
							}
						</div>
						<span>{ t.Name }</span>
					</a>
				}
			</section>
		}
		<div class="shop-head">
			<div>
				<div class="eyebrow">
					if f.Room != "" {
						{ taxonomy.RoomName(f.Room) }
					} else {
						Shop
					}
				</div>
				<h1 class="h1">
					if f.Query != "" {
						Results for “{ f.Query }”
					} else if f.Category != "" {
						{ f.Category }
					} else if brand != nil {
						{ brand.Name }
					} else if f.Room != "" {
						{ taxonomy.RoomName(f.Room) }
					} else {
						All products
					}
				</h1>
				<div class="muted small">{ Thousands(r.Total) } { Plural(r.Total, "product", "products") }
					if r.Took > 0 {
						<span class="dim"> · { r.Took.Round(1000000).String() }</span>
					}
				</div>
			</div>
			<div class="sort">
				<label>Sort
					<select name="sort" hx-get={ u.Sort("") } hx-trigger="change" hx-vals="js:{sort: event.target.value}" hx-target="#shop" hx-select="#shop" hx-swap="outerHTML" hx-push-url="true">
						<option value="" selected?={ f.Sort == "" }>Featured</option>
						<option value="price-asc" selected?={ f.Sort == "price-asc" }>Price: low to high</option>
						<option value="price-desc" selected?={ f.Sort == "price-desc" }>Price: high to low</option>
					</select>
				</label>
			</div>
		</div>
		if chips := u.Active(); len(chips) > 0 {
			<div class="chips">
				for _, c := range chips {
					<a class="chip" href={ c[1] }>{ c[0] } <span aria-hidden="true">×</span></a>
				}
				<a class="chip clear" href={ u.Clear() }>Clear all</a>
			</div>
		}
		<div class="shop-grid">
			<aside class="facets" hx-target="#shop" hx-select="#shop" hx-swap="outerHTML show:none" hx-push-url="true">
				<details class="facet" data-open>
					<summary>Category</summary>
					<ul>
						for _, c := range r.Categories {
							<li><a href={ u.Category(c.Value) } class={ templ.KV("on", f.Category == c.Value) }>{ c.Label } <span class="n">{ Thousands(c.Count) }</span></a></li>
						}
					</ul>
				</details>
				<details class="facet" data-open>
					<summary>Finish</summary>
					<ul class="tones">
						for _, t := range r.Tones {
							<li><a href={ u.Tone(t.Value) } class={ templ.KV("on", u.HasTone(t.Value)) }><i class="dot" { SwatchStyle(t.Value)... }></i>{ t.Label } <span class="n">{ Thousands(t.Count) }</span></a></li>
						}
					</ul>
				</details>
				<details class="facet" data-open?={ brand == nil }>
					<summary>Brand</summary>
					<ul>
						for _, b := range r.Brands {
							<li><a href={ u.Brand(b.Value) } class={ templ.KV("on", f.Brand == b.Value) }>{ b.Label } <span class="n">{ Thousands(b.Count) }</span></a></li>
						}
					</ul>
				</details>
				<details class="facet">
					<summary>Parts &amp; rough-ins</summary>
					<ul><li><a href={ u.Parts() } class={ templ.KV("on", f.ShowParts) }>Show parts</a></li></ul>
				</details>
			</aside>
			<section>
				if len(r.Cards) == 0 {
					<div class="empty">
						<h2>Nothing matches yet.</h2>
						<p>Try fewer filters, another finish, or search by model number.</p>
					</div>
				} else {
					<ul class="grid">
						for i, c := range r.Cards {
							@CardTile(c, i)
						}
					</ul>
					@Pager(u, r)
				}
			</section>
		</div>
	</div>
}

templ CardTile(c store.Card, i int) {
	<li class="card">
		<a href={ "/p/" + i64(c.FamilyID) }>
			<div class="card-img" { Placeholder(c.LQIP)... }>
				if c.Hash != nil {
					<img { Eager(CardImg(*c.Hash, deref(c.W), deref(c.H)), i)... } alt={ c.Title }/>
				} else {
					<div class="noimg" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m21 16-5-5-8 8"></path></svg></div>
				}
			</div>
			<div class="card-body">
				<div class="eyebrow">{ c.Brand }</div>
				<div class="card-title">{ Truncate(c.Title, 72) }</div>
				<div class="card-meta">
					if pr := Price(c.PriceCents); pr != "" {
						<span class="price">{ pr }</span>
					} else {
						<span class="muted">Call for price</span>
					}
					if len(c.Tones) > 0 {
						<span class="dots" aria-label="Finishes">
							for _, t := range c.Tones {
								<i class="dot" { SwatchStyle(t)... }></i>
							}
						</span>
					}
				</div>
			</div>
		</a>
	</li>
}

templ Pager(u ShopURL, r *store.Result) {
	if r.Pages > 1 {
		<nav class="pager" aria-label="Pages">
			if r.Page > 1 {
				<a href={ u.Page(r.Page - 1) } rel="prev">‹ Prev</a>
			}
			for _, n := range pageWindow(r.Page, r.Pages) {
				if n == 0 {
					<span class="gap">…</span>
				} else if n == r.Page {
					<span class="cur" aria-current="page">{ Itoa(n) }</span>
				} else {
					<a href={ u.Page(n) }>{ Itoa(n) }</a>
				}
			}
			if r.Page < r.Pages {
				<a href={ u.Page(r.Page + 1) } rel="next">Next ›</a>
			}
		</nav>
	}
}

// Suggest is the typeahead dropdown partial.
templ Suggest(items []store.Suggestion, q string) {
	if len(items) > 0 {
		<ul>
			for _, s := range items {
				<li role="option">
					<a href={ s.URL } hx-boost="false">
						if s.Kind == "family" {
							<span class="s-img">
								if s.Hash != nil {
									<img src={ Thumb(*s.Hash) } alt="" width="40" height="40" loading="lazy"/>
								}
							</span>
							<span class="s-text"><span>{ s.Label }</span><small>{ s.Sub }</small></span>
						} else {
							<span class="s-kind">{ s.Kind }</span>
							<span class="s-text"><span>{ s.Label }</span><small>{ s.Sub }</small></span>
						}
					</a>
				</li>
			}
			<li class="s-all"><a href={ "/search?q=" + q } hx-boost="false">See all results for “{ q }”</a></li>
		</ul>
	}
}
