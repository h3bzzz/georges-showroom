package views

import (
	"georges/internal/store"
	"georges/internal/taxonomy"
)

templ Home(p Page, rooms map[string]store.Cover, featured []store.Card, brands []store.Brand, books []store.Catalog) {
	@Layout(p) {
		<section class="hero">
			<div class="hero-text">
				<div class="eyebrow">Pasadena · since 1935</div>
				<h1>Every faucet, tub, sink and door handle worth having. One showroom.</h1>
				<p>Browse { Thousands(p.Rooms["bathroom"] + p.Rooms["kitchen"] + p.Rooms["hardware"] + p.Rooms["appliances"]) } products from the brands we stock, with real photographs and the maker's spec sheets.</p>
				<form class="hero-search" action="/search" method="get" hx-boost="false">
					<input type="search" name="q" placeholder="Try “brushed nickel kitchen faucet” or a model number" aria-label="Search"/>
					<button class="btn primary" type="submit">Search</button>
				</form>
			</div>
			<ul class="rooms">
				for _, rm := range taxonomy.Rooms {
					<li>
						<a class="room" href={ "/shop/" + rm.Slug }>
							if c, ok := rooms["room|" + rm.Slug]; ok {
								<img src={ "/img/960/" + c.Path } srcset={ "/img/640/" + c.Path + " 640w, /img/960/" + c.Path + " 960w, /img/1600/" + c.Path + " 1600w" } sizes="(min-width:1024px) 25vw, 50vw" alt="" loading="lazy" decoding="async"/>
							}
							<span class="label">{ rm.Name } <small>{ Thousands(p.Rooms[rm.Slug]) }</small></span>
						</a>
					</li>
				}
			</ul>
		</section>
		if len(featured) > 0 {
			<section class="section">
				<div class="section-head"><h2>Featured</h2><a href="/shop">Shop all ›</a></div>
				<ul class="grid">
					for i, c := range featured {
						@CardTile(c, i)
					}
				</ul>
			</section>
		}
		<section class="section">
			<div class="section-head"><h2>Brands</h2><a href="/brands">All { Itoa(len(brands)) } brands ›</a></div>
			<ul class="brand-wall">
				for _, b := range brands {
					if b.Featured && b.LogoPath != nil {
						<li><a href={ "/brand/" + b.Slug } title={ b.Name }><img src={ FileURL(*b.LogoPath) } alt={ b.Name } loading="lazy"/></a></li>
					}
				}
			</ul>
		</section>
		if len(books) > 0 {
			<section class="section">
				<div class="section-head"><h2>Latest catalogs</h2><a href="/catalogs">All catalogs ›</a></div>
				<ul class="shelf">
					for _, b := range books {
						<li><a href={ "/catalog/" + Itoa(b.ID) }>
							if b.CoverPath != nil {
								<img src={ "/img/320/" + *b.CoverPath } alt="" loading="lazy" width="150" height="200"/>
							}
							<span>{ catalogTitle(b) }</span>
						</a></li>
					}
				</ul>
			</section>
		}
	}
}

templ Brands(p Page, brands []store.Brand) {
	@Layout(p) {
		<div class="eyebrow">Brands</div>
		<h1 class="h1">{ Itoa(len(brands)) } brands on the floor</h1>
		<ul class="brand-grid">
			for _, b := range brands {
				if b.Families > 0 {
					<li><a href={ "/brand/" + b.Slug }>
						<span class="brand-tile">
							if b.LogoPath != nil {
								<img src={ FileURL(*b.LogoPath) } alt={ b.Name } loading="lazy"/>
							} else {
								<span class="brand-text">{ b.Name }</span>
							}
						</span>
						<span class="muted small">{ Thousands(b.Families) } products</span>
					</a></li>
				}
			}
		</ul>
	}
}

templ Catalogs(p Page, books []store.Catalog, brand string) {
	@Layout(p) {
		<div class="eyebrow">Library</div>
		<h1 class="h1">Vendor catalogs</h1>
		<p class="muted">{ Itoa(len(books)) } books, searchable page by page.</p>
		<ul class="books">
			for _, b := range books {
				<li><a href={ "/catalog/" + Itoa(b.ID) }>
					<span class="book-cover">
						if b.CoverPath != nil {
							<img src={ "/img/320/" + *b.CoverPath } alt="" loading="lazy" width="160" height="210"/>
						}
					</span>
					<span class="book-title">{ catalogTitle(b) }</span>
					if b.BrandName != nil {
						<span class="muted small">{ *b.BrandName }
							if b.Pages != nil {
								· { Itoa(*b.Pages) } pages
							}
						</span>
					}
				</a></li>
			}
		</ul>
	}
}

templ Reader(p Page, c *store.Catalog, page int, toc []store.TOCEntry) {
	@Layout(p) {
		{{ n := 1 }}
		if c.Pages != nil {
			{{ n = *c.Pages }}
		}
		<div class="reader">
			<aside class="toc">
				<div class="eyebrow">
					if c.BrandName != nil {
						{ *c.BrandName }
					}
				</div>
				<h1 class="h2">{ catalogTitle(*c) }</h1>
				<p class="muted small">Page { Itoa(page) } of { Itoa(n) }</p>
				if len(toc) > 0 {
					<ol class="toc-list">
						for _, t := range toc {
							<li class={ templ.KV("l2", t.Level > 1), templ.KV("on", t.Page == page) }><a href={ "/catalog/" + Itoa(c.ID) + "/read?page=" + Itoa(t.Page) }>{ t.Title } <span class="n">{ Itoa(t.Page) }</span></a></li>
						}
					</ol>
				}
			</aside>
			<section class="pages">
				<nav class="reader-nav">
					if page > 1 {
						<a class="btn" href={ "/catalog/" + Itoa(c.ID) + "/read?page=" + Itoa(page-1) } rel="prev">‹ Previous</a>
					}
					<form action={ templ.SafeURL("/catalog/" + Itoa(c.ID) + "/read") } method="get" hx-boost="false"><label>Go to page <input type="number" name="page" min="1" max={ Itoa(n) } value={ Itoa(page) }/></label></form>
					if page < n {
						<a class="btn" href={ "/catalog/" + Itoa(c.ID) + "/read?page=" + Itoa(page+1) } rel="next">Next ›</a>
					}
				</nav>
				<img class="page-img" src={ PageImg(c.ID, page) } alt={ "Page " + Itoa(page) } width="1700" height="2200" fetchpriority="high"/>
			</section>
		</div>
	}
}

templ PageHits(p Page, q string, hits []store.PageHit) {
	@Layout(p) {
		<div class="eyebrow">Catalog pages</div>
		<h1 class="h1">“{ q }” in the catalogs</h1>
		<ul class="hits">
			for _, h := range hits {
				<li>
					<a href={ "/catalog/" + Itoa(h.CatalogID) + "/read?page=" + Itoa(h.Page) }>
						<img src={ PageImg(h.CatalogID, h.Page) } alt="" loading="lazy" width="120" height="155"/>
						<span><strong>{ h.Catalog }</strong> · page { Itoa(h.Page) }
							if h.Brand != nil {
								<small>{ *h.Brand }</small>
							}
							<em>@templ.Raw(h.Snippet)</em>
						</span>
					</a>
				</li>
			}
		</ul>
	}
}
