package views

import "georges_/internal/store"

// AdminCovers is the internal curation page for banners and category tiles.
templ AdminCovers(room string, banner RoomTile, roomCands []store.Cover, sets []CoverSet) {
	@Layout("Cover picker") {
		<div class="flex items-baseline gap-4 mb-6 flex-wrap">
			<div>
				<div class="eyebrow">Internal · curation</div>
				<h1 class="font-display text-3xl" style="font-weight:500">Choose the imagery</h1>
			</div>
			@coverNav(room)
		</div>
		<section id={ AnchorFor("room", room) } class="mb-12">
			<h2 class="font-display text-xl mb-3" style="font-weight:500">Room banner</h2>
			<div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-6">
				<div>
					<div class="eyebrow mb-1">Current</div>
					<div class="room-banner" style="height:150px">
						if banner.Image != "" {
							<img src={ Img(banner.Image, 960) } alt=""/>
						} else if banner.CatalogID > 0 {
							<img src={ "/catalog/" + Itoa(banner.CatalogID) + "/page/" + Itoa(banner.Page) } alt=""/>
						}
					</div>
					<form method="post" action="/admin/covers" class="mt-2"><input type="hidden" name="kind" value="room"/><input type="hidden" name="key" value={ room }/><input type="hidden" name="room" value={ room }/><button name="clear" value="1" class="text-xs" style="color:var(--nickel)">Reset to automatic</button></form>
				</div>
				<div>
					<div class="eyebrow mb-1">Candidates from the books</div>
					@candidateGrid("room", room, room, roomCands)
				</div>
			</div>
		</section>
		for _, set := range sets {
			<section id={ AnchorFor("category", store.CoverKey(room, set.Tile.Name)) } class="mb-10">
				<h2 class="font-display text-xl mb-3" style="font-weight:500">{ set.Tile.Name } <span class="text-sm num" style="color:var(--nickel)">{ Itoa(set.Tile.Count) } products</span></h2>
				<div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-6">
					<div>
						<div class="eyebrow mb-1">Current</div>
						<div class="cat-tile-img rounded-lg overflow-hidden">
							if set.Tile.Cover.Path != "" {
								<img src={ Img("/files/" + set.Tile.Cover.Path, 640) } alt=""/>
							}
						</div>
						<form method="post" action="/admin/covers" class="mt-2"><input type="hidden" name="kind" value="category"/><input type="hidden" name="key" value={ store.CoverKey(room, set.Tile.Name) }/><input type="hidden" name="room" value={ room }/><button name="clear" value="1" class="text-xs" style="color:var(--nickel)">Reset to automatic</button></form>
					</div>
					<div>
						@candidateGrid("category", store.CoverKey(room, set.Tile.Name), room, set.Candidates)
					</div>
				</div>
			</section>
		}
		<p class="text-xs mt-8 max-w-2xl" style="color:var(--nickel)">A file dropped at DATA_DIR/covers/&lt;room&gt;.jpg overrides the room banner; picks made here are stored in the covers table and win over the automatic choice.</p>
	}
}

templ candidateGrid(kind, key, room string, cands []store.Cover) {
	if len(cands) == 0 {
		<p class="text-sm" style="color:var(--nickel)">No wide photographs found yet for this. More appear as the pipeline finishes the books.</p>
	} else {
		<div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
			for _, c := range cands {
				<form method="post" action="/admin/covers" class="group">
					<input type="hidden" name="kind" value={ kind }/><input type="hidden" name="key" value={ key }/><input type="hidden" name="room" value={ room }/>
					<input type="hidden" name="path" value={ c.Path }/><input type="hidden" name="catalog_id" value={ Itoa(c.CatalogID) }/><input type="hidden" name="page" value={ Itoa(c.Page) }/>
					<button class="block w-full text-left rounded-lg overflow-hidden bg-white" style="border:1px solid var(--line)">
						<img src={ Img("/files/" + c.Path, 480) } alt="" class="w-full object-cover" style="aspect-ratio:16/10" loading="lazy"/>
						<div class="px-2 py-1 text-[0.7rem] num flex justify-between" style="color:var(--nickel)"><span>{ Itoa(c.W) }×{ Itoa(c.H) }</span><span>p. { Itoa(c.Page) }</span></div>
					</button>
				</form>
			}
		</div>
	}
}

// coverNav switches the curation page between the rooms and the landing tiles.
templ coverNav(room string) {
	<nav class="flex gap-2 text-sm">
		for _, rm := range store.Rooms {
			<a href={ templ.SafeURL("/admin/covers?room=" + rm.Slug) } class="rounded-full px-3 py-1.5" style={ roomChipStyle(rm.Slug == room) }>{ rm.Name }</a>
		}
		<a href="/admin/covers?room=home" class="rounded-full px-3 py-1.5" style={ roomChipStyle(room == "home") }>Home tiles</a>
	</nav>
}

// AdminHomeTiles curates the landing tile photographs (covers kind "home", keyed by tile name).
templ AdminHomeTiles(sets []HomeCoverSet) {
	@Layout("Cover picker") {
		<div class="flex items-baseline gap-4 mb-6 flex-wrap">
			<div>
				<div class="eyebrow">Internal · curation</div>
				<h1 class="font-display text-3xl" style="font-weight:500">Landing tiles</h1>
			</div>
			@coverNav("home")
		</div>
		for _, set := range sets {
			<section id={ AnchorFor("home", set.Tile.Name) } class="mb-10">
				<h2 class="font-display text-xl mb-3" style="font-weight:500">
					{ set.Tile.Name }
					<span class="text-sm num" style="color:var(--nickel)">{ Itoa(set.Tile.Count) } products</span>
					<a href={ templ.SafeURL(set.Tile.Href) } class="text-sm font-medium ml-2" style="color:var(--accent)">open →</a>
				</h2>
				<div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-6">
					<div>
						<div class="eyebrow mb-1">Current</div>
						<div class="tile-img rounded-lg overflow-hidden">
							if set.Tile.Cover.Path != "" {
								<img src={ Img("/files/" + set.Tile.Cover.Path, 640) } alt=""/>
							}
						</div>
						if set.Tile.Caption != "" {
							<div class="text-xs mt-1" style="color:var(--nickel)">from { set.Tile.Caption }</div>
						}
						<form method="post" action="/admin/covers" class="mt-2"><input type="hidden" name="kind" value="home"/><input type="hidden" name="key" value={ set.Tile.Name }/><input type="hidden" name="room" value="home"/><button name="clear" value="1" class="text-xs" style="color:var(--nickel)">Reset to automatic</button></form>
					</div>
					<div>
						<div class="eyebrow mb-1">Candidates from the books</div>
						@candidateGrid("home", set.Tile.Name, "home", set.Candidates)
					</div>
				</div>
			</section>
		}
		<p class="text-xs mt-8 max-w-2xl" style="color:var(--nickel)">A tile without a pick of its own reuses the room page's curated cover for the same category, then the best catalog photograph about the subject. Picks made here win over both.</p>
	}
}
