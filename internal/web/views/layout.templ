package views

import "georges/internal/taxonomy"

// Page is what every template needs from the request.
type Page struct {
	Title       string
	Description string
	Canonical   string
	Rooms       map[string]int
	Query       string
	Dev         bool
	Chat        bool // the assistant is configured
	Rep         bool // trade mode cookie present
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>
				if p.Title != "" {
					{ p.Title } · George's Kitchen & Bath
				} else {
					George's Kitchen & Bath · Pasadena showroom
				}
			</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
			}
			if p.Canonical != "" {
				<link rel="canonical" href={ p.Canonical }/>
			}
			<link rel="stylesheet" href={ "/static/app.css?v=" + AssetVersion }/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/icon-32.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/icon-180.png"/>
			<meta name="theme-color" content="#F5F6F7" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)"/>
			<meta name="color-scheme" content="light dark"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
			<script src={ "/static/app.js?v=" + AssetVersion } defer></script>
		</head>
		<body hx-boost="true" hx-target="#main" hx-select="#main" hx-swap="outerHTML show:window:top" hx-push-url="true">
			<a class="skip" href="#main">Skip to content</a>
			<header class="hdr">
				<div class="wrap hdr-row">
					<a href="/" class="logo" aria-label="George's Kitchen &amp; Bath home" hx-boost="false">
						<picture>
							<source srcset="/static/logo-dark.png" media="(prefers-color-scheme: dark)"/>
							<img src="/static/logo-light.png" alt="George's Kitchen &amp; Bath" width="357" height="90" fetchpriority="high"/>
						</picture>
					</a>
					<nav class="nav" aria-label="Rooms">
						for _, rm := range taxonomy.Rooms {
							<a href={ "/shop/" + rm.Slug }>{ rm.Name }</a>
						}
						<a href="/brands">Brands</a>
						<a href="/catalogs">Catalogs</a>
					</nav>
					<form class="search" action="/search" method="get" role="search" hx-boost="false" autocomplete="off">
						<input id="q" type="search" name="q" value={ p.Query } placeholder="Search a model number, finish, brand…" aria-label="Search" aria-controls="suggest" aria-expanded="false"
							hx-get="/suggest" hx-trigger="input changed delay:180ms, focus" hx-target="#suggest" hx-swap="innerHTML" hx-select="unset" hx-push-url="false"/>
						<button type="submit" aria-label="Search">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
						</button>
						<div id="suggest" class="suggest" role="listbox"></div>
					</form>
				</div>
			</header>
			<main id="main" class="wrap">
				{ children... }
			</main>
			if p.Chat {
				@ChatDrawer(p)
			}
			<footer class="ftr wrap">
				<div>
					<strong>George's Kitchen &amp; Bath</strong>
					<span>99 Palmetto Drive, Pasadena, CA 91105</span>
					<a href="tel:+16267925547">626.792.5547</a>
				</div>
				<div class="muted">Showroom hours Mon–Fri 8–5, Sat 9–3. Trade pricing for professionals.</div>
			</footer>
		</body>
	</html>
}

templ ErrorPage(p Page, code int, msg string) {
	@Layout(p) {
		<section class="empty">
			<div class="eyebrow">{ Itoa(code) }</div>
			<h1>{ msg }</h1>
			<p>Try a search, or start from a room.</p>
			<p class="row">
				for _, rm := range taxonomy.Rooms {
					<a class="btn" href={ "/shop/" + rm.Slug }>{ rm.Name }</a>
				}
			</p>
		</section>
	}
}

// ChatDrawer is the assistant: a launcher button and a panel the script in app.js drives.
templ ChatDrawer(p Page) {
	<button type="button" class="chat-launch" id="chat-launch" aria-controls="chat" aria-expanded="false" title="Ask the showroom">
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8z"></path></svg>
		<span>Ask the showroom</span>
	</button>
	<aside class="chat" id="chat" hidden aria-label="Showroom assistant" data-rep?={ p.Rep } data-page={ p.Canonical }>
		<header class="chat-head">
			<div>
				<strong>George's assistant</strong>
				<small class="muted">
					if p.Rep {
						Trade mode · answers from our catalog
					} else {
						Answers from our catalog and the makers' spec sheets
					}
				</small>
			</div>
			<button type="button" class="chat-reset" id="chat-reset" title="Start over">New chat</button>
			<button type="button" class="chat-close" id="chat-close" aria-label="Close">×</button>
		</header>
		<div class="chat-log" id="chat-log" role="log" aria-live="polite">
			<div class="chat-hello">
				<p>Tell me the room, the look and the budget, or paste a model number. You can also attach a photo of a fixture you like and I'll find what we carry that resembles it.</p>
				<div class="chat-starters">
					<button type="button" data-q="Brushed nickel pull-down kitchen faucet under $800">Brushed nickel pull-down kitchen faucet under $800</button>
					<button type="button" data-q="Wall-mount tub filler in matte black">Wall-mount tub filler in matte black</button>
					<button type="button" data-q="Which brands do you carry for door hardware?">Which brands do you carry for door hardware?</button>
					<button type="button" data-q="What is the spout reach of the Brizo Litze pull-down?">Spout reach of the Brizo Litze pull-down</button>
				</div>
			</div>
		</div>
		<form class="chat-form" id="chat-form" autocomplete="off">
			<div class="chat-attach" id="chat-attach" hidden><img id="chat-attach-img" alt="Attached photo"/><button type="button" id="chat-attach-x" aria-label="Remove photo">×</button></div>
			<div class="chat-row">
				<label class="chat-photo" title="Attach a photo">
					<input type="file" id="chat-file" accept="image/jpeg,image/png,image/webp"/>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
				</label>
				<textarea id="chat-input" rows="1" placeholder="Ask about a fixture, finish or brand…" aria-label="Your question" maxlength="2000"></textarea>
				<button type="submit" class="chat-send" id="chat-send" aria-label="Send">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</button>
			</div>
		</form>
	</aside>
}
