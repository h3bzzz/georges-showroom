package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · George's Kitchen &amp; Bath</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Manrope:wght@400;500;600;700&display=swap"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			<link rel="stylesheet" href={ "/static/app.css?v=" + AssetVersion }/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/icon-32.png"/>
			<link rel="icon" type="image/png" sizes="64x64" href="/static/icon-64.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/icon-180.png"/>
			<meta name="theme-color" content="#00A1E9"/>
		</head>
		<body class="min-h-full" hx-boost="true">
			<header class="sticky top-0 z-20" style="background:rgba(244,244,242,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)">
				<div class="max-w-7xl mx-auto px-4 md:px-6 h-16 flex items-center gap-8">
					<a href="/" class="no-underline shrink-0" aria-label="George's Kitchen &amp; Bath home">
						<img src="/static/logo-transparent.png" alt="George's Kitchen &amp; Bath" class="logo-wordmark" width="357" height="90"/>
					</a>
					<nav class="hidden md:flex gap-6 text-[0.86rem] font-medium" style="color:var(--nickel)">
						<a class="hover:text-[color:var(--ink)]" href="/shop/bathroom">Bathroom</a>
						<a class="hover:text-[color:var(--ink)]" href="/shop/kitchen">Kitchen</a>
						<a class="hover:text-[color:var(--ink)]" href="/shop/hardware">Hardware</a>
						<a class="hover:text-[color:var(--ink)]" href="/shop/appliances">Appliances</a>
						<a class="hover:text-[color:var(--ink)]" href="/brands">Brands</a>
						<a class="hover:text-[color:var(--ink)]" href="/catalogs">Catalogs</a>
					</nav>
					<div class="ml-auto relative w-full max-w-sm">
						<input id="q" type="search" name="q" placeholder="Search SKU, finish, catalog…"
							class="w-full rounded-full border px-4 py-1.5 text-sm bg-white" style="border-color:var(--line)"
							hx-get="/search" hx-trigger="input changed delay:250ms, keyup[key=='Enter']" hx-target="#search-results" hx-indicator="#search-spinner" autocomplete="off"/>
						<span id="search-spinner" class="htmx-indicator absolute right-3 top-2 text-xs" style="color:var(--nickel)">…</span>
						<div id="search-results" class="absolute left-0 right-0 mt-1"></div>
					</div>
				</div>
			</header>
			<main class="max-w-7xl mx-auto px-4 md:px-6 py-8">
				{ children... }
			</main>
			<footer class="max-w-7xl mx-auto px-4 md:px-6 py-12 text-xs" style="color:var(--nickel);border-top:1px solid var(--line)">
				<div class="flex flex-wrap items-center gap-x-8 gap-y-2">
					<img src="/static/icon-64.png" alt="" class="logo-mark"/>
					<span class="font-display text-base" style="color:var(--ink)">George's Kitchen &amp; Bath</span>
					<span>99 Palmetto Drive, Pasadena, CA 91105</span>
					<span class="num">626.792.5547</span>
				</div>
			</footer>
		</body>
	</html>
}
