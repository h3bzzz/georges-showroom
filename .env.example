# Site login (Unilog CX1 admin user)
SITE_BASE_URL=https://www.georgesshowroom.com
SITE_USER=
SITE_PASS=

# Company price file FTP (see /Price-File-Access.HTML on the site admin dashboard)
FTP_HOST=ftp.myplumbingshowroom.com
FTP_USER=
FTP_PASS=

# Storage
DATABASE_URL=postgres://georges:georges@localhost:5432/georges2?sslmode=disable
# v1 database the importer reads
LEGACY_DATABASE_URL=postgres://georges:georges@localhost:5432/georges?sslmode=disable
# dev | prod
ENV=dev
ADDR=:8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data/raw

# Browser
CHROME_BIN=/usr/bin/google-chrome-stable
CHROME_PROFILE_DIR=./.chrome-profile
CHROME_HEADLESS=false

# Attach to your own Chrome instead of launching one: start Chrome with --remote-debugging-port=9222 and set
# CHROME_CONTROL_URL=http://127.0.0.1:9222

# Brave Search API key (https://brave.com/search/api/, free tier) — makes `georges webimages` find product photos on brand sites
BRAVE_API_KEY=
